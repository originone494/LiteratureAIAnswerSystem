3002  \n2. **\u6587\u6863\u7d22\u5f15\u5316**\uff1a\u5c06\u5904\u7406\u540e\u7684\u6587\u672c\u5207\u5206\u4e3a\u5c0f\u5757\uff08Chunks\uff09\uff0c\u901a\u8fc7\u7f16\u7801\u5668\uff08\u5982Transformer Encoder\uff09\u5c06\u5176\u8f6c\u6362\u4e3a\u5411\u91cf\uff0c\u5e76\u5efa\u7acb\u53ef\u68c0\u7d22\u7684\u5411\u91cf\u6570\u636e\u5e93\u3002  \n3. **\u67e5\u8be2\u7406\u89e3**\uff1a\u7cfb\u7edf\u89e3\u6790\u7528\u6237\u8f93\u5165\u7684\u95ee\u9898\uff0c\u7406\u89e3\u5176\u8bed\u4e49\u610f\u56fe\u3002  \n4. **\u67e5\u8be2\u5411\u91cf\u5316**\uff1a\u4f7f\u7528\u4e0e\u6587\u6863\u7d22\u5f15\u9636\u6bb5\u76f8\u540c\u7684\u7f16\u7801\u5668\uff0c\u5c06\u7528\u6237\u67e5\u8be2\u8f6c\u6362\u4e3a\u5411\u91cf\u8868\u793a\u3002  \n5. **\u68c0\u7d22**\uff1a\u5728\u5411\u91cf\u6570\u636e\u5e93\u4e2d\uff0c\u57fa\u4e8e\u76f8\u4f3c\u5ea6\u5ea6\u91cf\uff08\u5982\u4f59\u5f26\u76f8\u4f3c\u5ea6\uff09\u67e5\u627e\u4e0e\u67e5\u8be2\u5411\u91cf\u6700\u76f8\u5173\u7684\u6587\u6863\u5757\u3002  \n6. **\u6587\u6863\u91cd\u6392\u5e8f**\uff08\u53ef\u9009\uff09\uff1a\u5bf9\u521d\u6b65\u68c0\u7d22\u7ed3\u679c\u8fdb\u884c\u91cd\u65b0\u6392\u5e8f\uff0c\u4ee5\u63d0\u5347\u76f8\u5173\u6027\u3002  \n7. **\u4e0a\u4e0b\u6587\u878d\u5408**\uff1a\u5c06\u68c0\u7d22\u5230\u7684\u76f8\u5173\u6587\u6863\u5757\u4e0e\u539f\u59cb\u67e5\u8be2\u7ed3\u5408\uff0c\u6784\u5efa\u589e\u5f3a\u7684\u4e0a\u4e0b\u6587\u8f93\u5165\u3002  \n8. **\u751f\u6210**\uff1a\u5229\u7528\u5927\u8bed\u8a00\u6a21\u578b\uff08LLM\uff09\u57fa\u4e8e\u878d\u5408\u540e\u7684\u4e0a\u4e0b\u6587\u751f\u6210\u56de\u7b54\u3002  \n9. **\u540e\u5904\u7406**\uff1a\u5bf9\u751f\u6210\u6587\u672c\u8fdb\u884c\u8bed\u6cd5\u68c0\u67e5\u3001\u6d41\u7545\u6027\u4f18\u5316\u6216\u4e8b\u5b9e\u6821\u6b63\u7b49\u3002  \n10. **\u7ed3\u679c\u8f93\u51fa**\uff1a\u5c06\u6700\u7ec8\u751f\u6210\u7684\u56de\u7b54\u8fd4\u56de\u7ed9\u7528\u6237\u3002\n\n**\u3010\u4f9d\u636e\u3011**  \n- \u6d41\u7a0b\u660e\u786e\u5212\u5206\u4e3a10\u4e2a\u6b65\u9aa4<sup>[1]</sup>\u3002  \n- \u4f7f\u7528\u76f8\u540c\u7f16\u7801\u5668\u5904\u7406\u6587\u6863\u548c\u67e5\u8be2\u4ee5\u4fdd\u8bc1\u5411\u91cf\u7a7a\u95f4\u4e00\u81f4\u6027<sup>[1]</sup>\u3002  \n- \u68c0\u7d22\u4f9d\u8d56\u5411\u91cf\u76f8\u4f3c\u5ea6\uff08\u5982\u4f59\u5f26\u76f8\u4f3c\u5ea6\uff09<sup>[1]</sup>\u3002  \n- \u4e0a\u4e0b\u6587\u878d\u5408\u662f\u8fde\u63a5\u68c0\u7d22\u4e0e\u751f\u6210\u7684\u5173\u952e\u73af\u8282<sup>[1]</sup>\u3002\n\n**\u3010\u9650\u5236\u4e0e\u5c55\u671b\u3011**  \n\u8be5\u6d41\u7a0b\u4f9d\u8d56\u9ad8\u8d28\u91cf\u7684\u6587\u6863\u5207\u5206\u4e0e\u5411\u91cf\u7f16\u7801\uff0c\u82e5\u5207\u5206\u4e0d\u5408\u7406\u6216\u7f16\u7801\u5668\u6027\u80fd\u4e0d\u8db3\uff0c\u4f1a\u5f71\u54cd\u68c0\u7d22\u6548\u679c\u3002\u6b64\u5916\uff0c\u91cd\u6392\u5e8f\u867d\u4e3a\u53ef\u9009\uff0c\u4f46\u5728\u590d\u6742\u67e5\u8be2\u4e2d\u53ef\u80fd\u663e\u8457\u63d0\u5347\u6027\u80fd\uff0c\u672a\u6765\u53ef\u7ed3\u5408\u66f4\u5148\u8fdb\u7684\u6392\u5e8f\u6a21\u578b\u3002\u5f53\u524d\u6d41\u7a0b\u672a\u6d89\u53ca\u591a\u8f6e\u5bf9\u8bdd\u72b6\u6001\u7ba1\u7406\uff0c\u9002\u7528\u4e8e\u5355\u8f6e\u95ee\u7b54\u573a\u666f\u3002\n\n**\u3010\u76f8\u5173\u56fe\u7247\u3011**  \n![\u56fe2 RAG\u7684\u5de5\u4f5c\u6d41\u7a0b](images/019d8689-db7f-7185-ad68-a5247efbb867_1_278_248_422_1155_0.jpg)\n\n**\u3010\u53c2\u8003\u6587\u732e\u3011**  \n[1] \u5927\u6a21\u578b\u68c0\u7d22\u589e\u5f3a\u751f\u6210(RAG)\u6280\u672f\u6d45\u6790", "additional_kwargs": {}, "response_metadata": {}, "type": "ai", "name": null, "id": null, "tool_calls": [], "invalid_tool_calls": [], "usage_metadata": null}}]